{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "d=$(jq -r '.cwd // empty'); cd \"${d:-${CLAUDE_PROJECT_DIR:-.}}\" || exit 0; git fetch -q origin main 2>/dev/null; set -- $(git rev-list --left-right --count main...origin/main 2>/dev/null); [ \"${1:-0}\" != 0 ] || [ \"${2:-0}\" != 0 ] && echo \"Local main is $1 commit(s) ahead of and $2 behind origin/main: bring it up to date before building on it.\"; true",
            "timeout": 30,
            "statusMessage": "Checking main against origin"
          },
          {
            "type": "command",
            "command": "d=$(jq -r '.cwd // empty'); cd \"${d:-${CLAUDE_PROJECT_DIR:-.}}\" || exit 0; sh .claude/hooks/ctags.sh",
            "timeout": 180,
            "statusMessage": "Building the ctags symbol index"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      },
      "autoUpdate": true
    },
    "skillworks": {
      "source": {
        "source": "github",
        "repo": "5thlayer/skillworks"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@mattpocock": true,
    "skillworks@skillworks": true
  }
}
